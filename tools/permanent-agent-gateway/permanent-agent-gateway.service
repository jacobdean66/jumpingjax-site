[Unit]
Description=Scoped Permanent Agent HTTPS upstream (Ask, Projects, Published only)
After=network.target cc-dashboard-operator.service
[Service]
User=permanent-agent-gateway
Group=permanent-agent-gateway
ExecStart=/usr/local/bin/node /opt/permanent-agent-production/source/tools/permanent-agent-gateway/permanent-agent-gateway.mjs
LoadCredential=service-token:/etc/permanent-agent-gateway/service-token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
[Install]
WantedBy=multi-user.target

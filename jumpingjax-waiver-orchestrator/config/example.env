# Jumping Jax Waiver Orchestrator — example environment variables
# Copy to a local .env on Jacob's Windows PC. Never commit real values.
# Variable NAMES only — no secrets in this repository.

# Transport mode: dry-run | mock | cloud-api | cli
ORCHESTRATOR_MODE=dry-run

# Absolute path to this orchestrator root (configure per machine; do not hard-code Linux VM paths)
ORCHESTRATOR_ROOT=

# Workspace the Cursor Builder may use (must NEVER be the dirty Jumping Jax checkout in dry-run)
# On Windows, example: C:\Users\jacob\jumpingjax-builder-workspace
CURSOR_BUILDER_WORKSPACE=

# Cursor Cloud Agents API / CLI credential (REQUIRED for cloud-api and cli modes)
# Fail-closed when missing. Never hard-code.
CURSOR_API_KEY=

# Optional Cloud Agents API base URL (verify against official docs before live use)
# CURSOR_CLOUD_API_BASE=https://api.cursor.com

# Optional path to local Cursor Agent CLI binary (Windows will differ from Linux)
# CURSOR_AGENT_BIN=agent

# Safety: refuse to operate if unexpected dirty Git state is detected in target workspace
ORCHESTRATOR_REFUSE_DIRTY_WORKSPACE=true

# Iteration guards (override project state defaults if set)
# ORCHESTRATOR_MAX_TASK_ITERATIONS=10
# ORCHESTRATOR_MAX_PROJECT_ITERATIONS=100

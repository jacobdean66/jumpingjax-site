# Jumping Jax Waiver Orchestrator — example environment variables
# Copy to a local .env on Jacob's Windows PC. Never commit real values.
# Variable NAMES only — names actually read by the current implementation.

# Absolute path for the Cursor Builder/Reviewer workspace.
# Dry-run / live smoke must stay inside this package's dry-run-workspace fixture.
# Example (Windows): C:\Users\jacob\jumpingjax-site\jumpingjax-waiver-orchestrator\dry-run-workspace
CURSOR_BUILDER_WORKSPACE=

# Cursor Cloud Agents API / CLI credential (required for cloud-api; also accepted by CLI auth checks)
# Fail-closed when missing for cloud-api. Never hard-code a real value.
CURSOR_API_KEY=

# Optional Cursor Cloud Agents API base URL (read by cloud adapter; verify before live use)
# CURSOR_CLOUD_API_BASE=https://api.cursor.com

# Optional override for the standalone Cursor Agent CLI binary/path
# Prefer leaving unset so Windows discovery can use %LOCALAPPDATA%\cursor-agent
# CURSOR_AGENT_BIN=

# Optional override for the Codex CLI binary used by @openai/codex-sdk
# Prefer leaving unset so the package can use the platform-bundled binary under node_modules
# CODEX_CLI_PATH=

# Optional Codex / OpenAI auth env names checked for presence by the Codex supervisor adapter
# Prefer Codex home auth (~/.codex/auth.json) when available. Never commit real values.
# CODEX_API_KEY=
# OPENAI_API_KEY=

# Supabase
# Project URL from Supabase -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe Supabase key. The code accepts either name; use one consistently.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only Supabase service role key. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URLs
# Vercel Production must use this exact canonical URL. Local development may
# override NEXT_PUBLIC_SITE_URL with http://localhost:3000 in .env.local.
NEXT_PUBLIC_SITE_URL=https://jumpingjaxllc.com
NEXT_PUBLIC_SEO_BASE_URL=https://jumpingjaxllc.com

# Email notifications through Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Jumping Jax <bookings@your-domain.example>
FACILITY_OWNER_EMAIL=owner@example.com

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary

# Optional separate calendars
GOOGLE_FACILITY_CALENDAR_ID=your-facility-calendar-id
GOOGLE_FOAM_CALENDAR_ID=your-foam-calendar-id

# Google Maps address validation / mileage
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI Creative Director (server-only)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini

# Admin / logistics access
ADMIN_DELIVERIES_TOKEN=change-this-private-token
ADMIN_EMPLOYEE_TOKEN=change-this-private-token
ADMIN_SESSION_SECRET=change-this-long-random-secret
APPROVAL_TOKEN_SECRET=change-this-separate-long-random-secret
ADMIN_OWNER_NAME=Owner
ADMIN_OWNER_USERNAME=owner
ADMIN_OWNER_PASSWORD=change-this-password
ADMIN_EMPLOYEE_1_NAME=Employee 1
ADMIN_EMPLOYEE_1_USERNAME=employee1
ADMIN_EMPLOYEE_1_PASSWORD=change-this-password
ADMIN_EMPLOYEE_2_NAME=Employee 2
ADMIN_EMPLOYEE_2_USERNAME=employee2
ADMIN_EMPLOYEE_2_PASSWORD=change-this-password

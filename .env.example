# Supabase (required for live availability + saving booking requests from the site)
# Project URL from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key — safe for the browser; Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Rental booking confirmation emails (Resend)
RESEND_API_KEY=your-resend-api-key
FACILITY_OWNER_EMAIL=owner@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar (server-only; rentals use GOOGLE_CALENDAR_ID by default)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary

# Optional: facility parties can use a separate calendar from inflatable rentals
GOOGLE_FACILITY_CALENDAR_ID=your-facility-calendar-id

# Optional: foam parties can use a separate calendar from inflatable rentals
GOOGLE_FOAM_CALENDAR_ID=your-foam-calendar-id

# Google Maps (server-only; used to verify rental delivery address + mileage)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Admin delivery board token (server-only)
ADMIN_DELIVERIES_TOKEN=change-this-private-token

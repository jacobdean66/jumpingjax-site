diff --git a/lib/limits.js b/lib/limits.js
new file mode 100644
index 0000000000000000000000000000000000000000..a9f7db13ba1703efe12f346f25ad83b0b70898cd
--- /dev/null
+++ b/lib/limits.js
@@ -0,0 +1,23 @@
+'use strict';
+
+// Bound recursive walkers even when callers supply an AST directly.
+const MAX_DEPTH = 64;
+const MAX_NODES = 262144;
+const assertAstLimits = ast => {
+  const stack = [{ node: ast, depth: 0 }];
+  let count = 0;
+  while (stack.length) {
+    const { node, depth } = stack.pop();
+    if (depth > MAX_DEPTH || ++count > MAX_NODES) {
+      throw new SyntaxError('Brace pattern exceeds safe nesting or node limit');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      if (node.nodes.length + stack.length + count > MAX_NODES) {
+        throw new SyntaxError('Brace pattern exceeds safe nesting or node limit');
+      }
+      for (const child of node.nodes) stack.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, assertAstLimits };
